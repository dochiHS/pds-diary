          "null": false,
          "meaning": "기간 시작일(서울 날짜)"
        },
        "end_date": {
          "type": "date",
          "null": false,
          "check": "start_date 이상, 기간 366일 이하",
          "meaning": "기간 끝일(서울 날짜)"
        },
        "priority": {
          "type": "smallint",
          "null": false,
